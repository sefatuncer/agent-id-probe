{
  "schema": "agent-id-probe/conformance-fixture/1",
  "id": "c13-violating-issuer-answers-as-another-host",
  "modality": "oauth_metadata",
  "title": "Declared issuer's metadata names a different authorization server entirely",
  "exercises": {
    "C13": "violating"
  },
  "decision_rules": [
    "R9.3"
  ],
  "rationale": "The failure RFC 9728 7.6 warns about, observed from outside: a client following the resource's declaration reaches a server that does not claim to be the one that was named.",
  "spec": [
    {
      "source": "RFC 8414",
      "section": "3.3",
      "url": "https://www.rfc-editor.org/rfc/rfc8414.html#section-3.3",
      "quote": "The `issuer` value returned MUST be identical to the authorization server's issuer identifier value into which the well-known URI string was inserted to create the URL used to retrieve the metadata.",
      "verification": "verbatim-verified in docs/spec-mapping.md"
    },
    {
      "source": "RFC 9728",
      "section": "7.6",
      "url": "https://www.rfc-editor.org/rfc/rfc9728.html#section-7.6",
      "quote": "Secure determination of appropriate authorization servers to use with a protected resource for all use cases is out of scope for this specification.",
      "verification": "verbatim-verified in docs/spec-mapping.md"
    }
  ],
  "endpoint": {
    "url": "https://api.example.org/mcp",
    "response": {
      "status": 401,
      "headers": {}
    }
  },
  "documents": [
    {
      "url": "https://api.example.org/.well-known/oauth-protected-resource/mcp",
      "status": 200,
      "json": {
        "resource": "https://api.example.org/mcp",
        "authorization_servers": [
          "https://auth.example.org"
        ]
      }
    },
    {
      "url": "https://auth.example.org/.well-known/oauth-authorization-server",
      "status": 200,
      "json": {
        "issuer": "https://different.example.net",
        "code_challenge_methods_supported": [
          "S256"
        ]
      }
    }
  ],
  "expect": {
    "checks": {
      "C13": "fail_misimplemented"
    },
    "evidence": {
      "as_issuer_relations": {
        "https://auth.example.org": "unrelated_host"
      }
    }
  }
}
