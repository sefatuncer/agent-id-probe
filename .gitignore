# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Raw measurement data: large, and not regenerable (the census cannot be re-collected).
# Not published; see docs/ETHICS.md section 8.
data/raw/**
!data/raw/.gitkeep

# Run outputs
results/runs/**
!results/runs/.gitkeep

# ...except the committed example. It is fully synthetic (RFC 2606 example.org hosts, see
# scripts/make_example_run.py), it is what `docs/data-schema.md` points at instead of
# describing records in the abstract, and it is what CI runs `rescore --verify` against —
# which turns decision rule R8 from a sentence in a document into a build step.
!results/runs/example/
!results/runs/example/**
!data/raw/example/
!data/raw/example/**

# The re-scored output of that example is regenerated by the verification itself.
results/runs/example-rescored/
data/raw/example-rescored/

# Local environment
.env
*.local

# coverage artefacts
.coverage
htmlcov/


# Client bench dependencies. The lockfile is committed and pins the versions every result
# record carries, so the tree is reproducible without shipping 95 packages.
client-bench/node_modules/

# Tier-1 client bench (client-bench/tier1): dependency caches and build outputs, written into
# each SDK's directory by its container. Versions are pinned by the committed manifests and
# lockfiles (package-lock.json, go.sum, Cargo.lock, bench.csproj) and by run.sh.
client-bench/tier1/ts/node_modules/
client-bench/tier1/python/site/
client-bench/tier1/go/.gopath/
client-bench/tier1/go/.gocache/
client-bench/tier1/go/bench
client-bench/tier1/ruby/gems/
client-bench/tier1/csharp/.nuget/
client-bench/tier1/csharp/obj/
client-bench/tier1/csharp/bin/
client-bench/tier1/csharp/out/
client-bench/tier1/rust/.cargo/
client-bench/tier1/rust/target/
